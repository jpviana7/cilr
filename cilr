          })}
          {(activeLocation.items || []).length === 0 && (
             <div className="text-center p-8 text-slate-500 italic">Sem procedimentos neste local.</div>
          )}
        </div>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans relative">
      {/* INDICADOR DE STATUS DE NUVEM FIXO */}
      <div className="fixed top-4 right-4 z-50 flex flex-col items-end space-y-2 pointer-events-none">
        {syncStatus === 'connecting' && <span className="bg-yellow-100 text-yellow-800 px-3 py-1.5 rounded-full text-xs font-bold flex items-center shadow-lg border border-yellow-200"><Loader2 className="w-3 h-3 mr-2 animate-spin"/> Conectando Nuvem...</span>}
        {syncStatus === 'saving' && <span className="bg-blue-100 text-blue-800 px-3 py-1.5 rounded-full text-xs font-bold flex items-center shadow-lg border border-blue-200"><Loader2 className="w-3 h-3 mr-2 animate-spin"/> Salvando Dados...</span>}
        {syncStatus === 'synced' && <span className="bg-green-100 text-green-800 px-3 py-1.5 rounded-full text-xs font-bold flex items-center shadow-lg border border-green-200"><Cloud className="w-3 h-3 mr-2"/> Sincronizado</span>}
        {syncStatus === 'error' && <span className="bg-red-100 text-red-800 px-3 py-1.5 rounded-full text-xs font-bold flex items-center shadow-lg border border-red-200"><CloudOff className="w-3 h-3 mr-2"/> Erro de Conexão</span>}
      </div>

      {/* BANNER DE ERRO DO FIREBASE */}
      {dbError && (
        <div className="bg-red-600 text-white p-3 text-sm text-center flex flex-col items-center justify-center shadow-md relative z-40">
          <div className="flex items-center font-bold">
            <AlertTriangle className="w-5 h-5 mr-2 flex-shrink-0" />
            <span>{dbError}</span>
          </div>
          {detailedDiagnostic && (
            <div className="mt-2 bg-red-800/50 p-3 rounded-lg text-xs font-mono max-w-2xl text-left border border-red-500/50">
              👉 {detailedDiagnostic}
            </div>
          )}
          <button onClick={() => setDbError('')} className="mt-3 underline font-bold opacity-80 hover:opacity-100 whitespace-nowrap">Fechar Aviso</button>
        </div>
      )}

      {view === 'home' && renderHome()}
      {view === 'admin-login' && renderAdminLogin()}
      {view === 'admin-list' && renderAdminList()}
      {view === 'admin-machine-edit' && renderAdminMachineEdit()}
      {view === 'admin-location-edit' && renderAdminLocationEdit()}
      {view === 'operator-list' && renderOperatorList()}
      {view === 'operator-machine' && renderOperatorMachine()}
      {view === 'operator-location' && renderOperatorLocation()}

      {/* MODAL DE CONFIRMAÇÃO */}
      {confirmDialog.show && (
        <div className="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
          <div className="bg-white rounded-2xl p-6 w-full max-w-sm shadow-2xl">
            <h3 className="text-lg font-bold text-slate-800 mb-2">Atenção</h3>
            <p className="text-slate-600 mb-6 font-medium">{confirmDialog.message}</p>
            <div className="flex space-x-3">
              <button onClick={() => setConfirmDialog({ show: false, message: '', onConfirm: null })} className="flex-1 py-3 bg-slate-100 text-slate-700 font-bold rounded-xl">Cancelar</button>
              <button onClick={confirmDialog.onConfirm} className="flex-1 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-md">Confirmar</button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL NOVO PROCEDIMENTO */}
      {itemModal.show && (
        <div className="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
          <div className="bg-white rounded-2xl p-6 w-full max-w-sm shadow-2xl">
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-lg font-bold text-slate-800">Novo Procedimento</h3>
              <button onClick={() => setItemModal({ show: false })} className="text-slate-400 bg-slate-100 rounded-full p-1"><X className="w-5 h-5" /></button>
            </div>
            
            <div className="space-y-4">
              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">O que inspecionar?</label>
                <input type="text" value={itemForm.description} onChange={(e) => setItemForm({...itemForm, description: e.target.value})} className="w-full p-3 rounded-xl border border-slate-300 focus:border-blue-500 outline-none font-medium" placeholder="Ex: Lâmina de Corte" />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Foto do Procedimento (Opcional)</label>
                {itemForm.imageUrl ? (
                  <div className="relative w-full h-32 rounded-xl overflow-hidden border border-slate-200">
                    <img src={itemForm.imageUrl} className="w-full h-full object-cover" />
                    <button type="button" onClick={() => setItemForm({...itemForm, imageUrl: ''})} className="absolute top-2 right-2 p-1.5 bg-red-500 text-white rounded-full shadow-md"><X className="w-4 h-4"/></button>
                  </div>
                ) : (
                  <label className="flex flex-col items-center justify-center w-full h-20 border-2 border-dashed border-blue-300 bg-blue-50/50 rounded-xl cursor-pointer hover:bg-blue-50">
                    <Upload className="w-5 h-5 text-blue-600 mb-1" />
                    <span className="text-xs text-blue-700 font-medium">Anexar foto detalhada (Opcional)</span>
                    <input type="file" accept="image/*" onChange={handleItemImageUpload} className="hidden" />
                  </label>
                )}
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-500 uppercase mb-2">Ação Requerida</label>
                <div className="flex bg-slate-100 p-1 rounded-lg mb-3">
                  <button className={`flex-1 py-2 text-sm font-bold rounded-md transition-all ${itemForm.type === 'simple' ? 'bg-white shadow text-blue-600' : 'text-slate-500'}`} onClick={() => setItemForm({...itemForm, type: 'simple'})}>Check Simples</button>
                  <button className={`flex-1 py-2 text-sm font-bold rounded-md transition-all ${itemForm.type === 'multi' ? 'bg-white shadow text-blue-600' : 'text-slate-500'}`} onClick={() => setItemForm({...itemForm, type: 'multi'})}>L.I.R.</button>
                </div>

                {itemForm.type === 'multi' && (
                  <div className="space-y-2 bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <label className="flex items-center space-x-3 cursor-pointer">
                      <input type="checkbox" checked={itemForm.tasks.L} onChange={(e) => setItemForm({...itemForm, tasks: {...itemForm.tasks, L: e.target.checked}})} className="w-5 h-5 rounded border-slate-300 text-blue-600" />
                      <span className="text-slate-700 font-medium"><strong>(L)</strong> Limpeza</span>
                    </label>
                    <label className="flex items-center space-x-3 cursor-pointer">
                      <input type="checkbox" checked={itemForm.tasks.I} onChange={(e) => setItemForm({...itemForm, tasks: {...itemForm.tasks, I: e.target.checked}})} className="w-5 h-5 rounded border-slate-300 text-blue-600" />
                      <span className="text-slate-700 font-medium"><strong>(I)</strong> Lubrificação</span>
                    </label>
                    <label className="flex items-center space-x-3 cursor-pointer">
                      <input type="checkbox" checked={itemForm.tasks.R} onChange={(e) => setItemForm({...itemForm, tasks: {...itemForm.tasks, R: e.target.checked}})} className="w-5 h-5 rounded border-slate-300 text-blue-600" />
                      <span className="text-slate-700 font-medium"><strong>(R)</strong> Reaperto</span>
                    </label>
                  </div>
                )}
              </div>

              <button onClick={handleSaveNewItem} disabled={!itemForm.description} className="w-full py-4 bg-blue-600 text-white font-bold rounded-xl disabled:opacity-50 shadow-md">Adicionar Procedimento</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
