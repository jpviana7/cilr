// Configuração do Firebase
const firebaseConfig = {
  apiKey: "AIzaSyBLezR02WMnL5tmS9BWz4pGPFf4cabRVsE",
  authDomain: "cil-r---digital.firebaseapp.com",
  projectId: "cil-r---digital",
  storageBucket: "cil-r---digital.firebasestorage.app",
  messagingSenderId: "415853282708",
  appId: "1:415853282708:web:38f7c4b147f64934b7fb81"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

// CORREÇÃO: NOME FIXO DA PASTA NO BANCO DE DADOS
// Garante que o celular e o computador leiam e gravem no mesmo exato lugar, independente do link.
const APP_ID_PATH = 'cil-r-digital-oficial-v1';

export default function App() {
  // Navegação
  const [view, setView] = useState('home'); // home, admin-login, admin-list, admin-machine-edit, admin-location-edit, operator-list, operator-machine, operator-location
  const [machines, setMachines] = useState([]);
  
  // IDs Ativos
  const [activeMachineId, setActiveMachineId] = useState(null);
  const [activeLocationId, setActiveLocationId] = useState(null);
  
  // Usuário e Autenticação
  const [user, setUser] = useState(null);
  const [isAdminLoggedIn, setIsAdminLoggedIn] = useState(false);
  const [passwordInput, setPasswordInput] = useState('');
  
  // Estados de Admin / Histórico
  const [adminTab, setAdminTab] = useState('machines');
  const [logs, setLogs] = useState([]);
  const [sessionStartTime, setSessionStartTime] = useState(null);
  const [selectedLine, setSelectedLine] = useState('');

  // Novo estado para exibir erros do Firebase e status de sincronia
  const [dbError, setDbError] = useState('');
  const [syncStatus, setSyncStatus] = useState('connecting'); // 'connecting', 'synced', 'saving', 'error'
  const [detailedDiagnostic, setDetailedDiagnostic] = useState('');
  
  // Estado para IA
  const [isGeneratingAI, setIsGeneratingAI] = useState(false);

  // Modais e Interações
  const [confirmDialog, setConfirmDialog] = useState({ show: false, message: '', onConfirm: null });
  const [itemModal, setItemModal] = useState({ show: false });
  const [itemForm, setItemForm] = useState({ description: '', type: 'simple', tasks: { L: false, I: false, R: false }, imageUrl: '' });
  const [expandedItemId, setExpandedItemId] = useState(null);

  // Derivados
  const availableLines = Array.from(new Set(machines.map(m => m.line).filter(Boolean))).sort();
  const activeTab = availableLines.includes(selectedLine) ? selectedLine : (availableLines[0] || '');
  const activeMachine = machines.find(m => m.id === activeMachineId);
  const activeLocation = activeMachine?.locations?.find(l => l.id === activeLocationId);

  // Navegação Helpers
  const goHome = () => setView('home');
  const goAdminList = () => isAdminLoggedIn ? setView('admin-list') : setView('admin-login');
  const goOperatorList = () => setView('operator-list');

  // --- EFEITOS DO FIREBASE ---
  useEffect(() => {
    const initAuth = async () => {
      setSyncStatus('connecting');
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          try {
            await signInWithCustomToken(auth, __initial_auth_token);
          } catch (tokenError) {
            await signInAnonymously(auth);
          }
        } else {
          await signInAnonymously(auth);
        }
        setDbError(''); 
        setDetailedDiagnostic('');
        setSyncStatus('synced');
      } catch (error) {
        console.error("Erro na autenticação:", error);
        if (error.code === 'auth/unauthorized-domain') {
          setDbError('ERRO: Domínio não autorizado no Firebase.');
          setDetailedDiagnostic('Vá no Firebase > Authentication > Configurações (Settings) > Domínios Autorizados e adicione este domínio: scf.usercontent.goog');
        } else {
          setDbError(`Erro de Autenticação: ${error.code}`);
          setDetailedDiagnostic(error.message);
        }
        setSyncStatus('error');
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if (!user) return;
    
    // Listeners em tempo real
    const machinesRef = collection(db, 'artifacts', APP_ID_PATH, 'public', 'data', 'machines');
    const unsubscribeMachines = onSnapshot(machinesRef, (snapshot) => {
      setMachines(snapshot.docs.map(doc => doc.data()));
      setSyncStatus('synced');
      setDbError('');
    }, (err) => {
      console.error("Erro Firestore Máquinas:", err);
      setDbError(`ERRO: O Firestore bloqueou o acesso.`);
      setDetailedDiagnostic('Verifique se você criou o "Firestore Database" (não o Realtime Database) e se as Regras estão definidas como "allow read, write: if true;".');
      setSyncStatus('error');
    });

    const logsRef = collection(db, 'artifacts', APP_ID_PATH, 'public', 'data', 'logs');
    const unsubscribeLogs = onSnapshot(logsRef, (snapshot) => {
      const data = snapshot.docs.map(doc => doc.data());
      data.sort((a, b) => new Date(b.endTime).getTime() - new Date(a.endTime).getTime());
      setLogs(data);
    }, (err) => {
      console.error("Erro Firestore Logs:", err);
    });

    return () => {
      unsubscribeMachines();
      unsubscribeLogs();
    };
  }, [user]);

  // --- HELPER DE SINCRONIZAÇÃO ---
  const syncMachine = async (machineToSync) => {
    if (!user) {
      setDbError('Desconectado da Nuvem.');
      setSyncStatus('error');
      return;
    }
    
    setSyncStatus('saving');
    try {
      const docRef = doc(db, 'artifacts', APP_ID_PATH, 'public', 'data', 'machines', machineToSync.id);
      await setDoc(docRef, machineToSync);
      setSyncStatus('synced');
      setDbError('');
    } catch(e) {
      console.error("Erro ao salvar:", e);
      setDbError(`Falha ao Gravar: O Firestore bloqueou a ação. Verifique as Regras de Segurança.`);
      setSyncStatus('error');
    }
  };

  // --- INTEGRAÇÃO GEMINI API ---
  const fetchWithRetry = async (url, options, retries = 5) => {
    const delays = [1000, 2000, 4000, 8000, 16000];
    for (let i = 0; i < retries; i++) {
      try {
        const res = await fetch(url, options);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } catch (err) {
        if (i === retries - 1) throw err;
        await new Promise(r => setTimeout(r, delays[i]));
      }
    }
  };

  const handleGenerateAITasks = async () => {
    if (!activeMachine || !activeLocation) return;
    setIsGeneratingAI(true);
    
    const apiKey = ""; // API Key is injected by the environment
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

    const prompt = `Aja como um especialista em manutenção industrial TPM e checklists CIL-R (Limpeza, Inspeção, Lubrificação, Reaperto). 
    Estou criando um checklist para o local "${activeLocation.name}" da máquina "${activeMachine.name}" na linha "${activeMachine.line}".
    Gere 3 a 5 procedimentos técnicos reais e importantes de inspeção, limpeza, lubrificação ou reaperto para este local.`;

    const payload = {
      contents: [{ parts: [{ text: prompt }] }],
      generationConfig: {
        responseMimeType: "application/json",
        responseSchema: {
          type: "ARRAY",
          items: {
            type: "OBJECT",
            properties: {
              description: { type: "STRING", description: "Ação a ser executada no formato imperativo (Ex: Limpar sensor ótico)" },
              type: { type: "STRING", description: "Use 'simple' para verificação visual, ou 'multi' se requerer tarefas L, I ou R" },
              tasks: {
                type: "ARRAY",
                items: { type: "STRING" },
                description: "Se type for 'multi', inclua as letras aplicáveis em maiúsculo: 'L' (Limpeza), 'I' (Lubrificação/Inspeção), 'R' (Reaperto). Se 'simple', array vazio."
              }
            },
            required: ["description", "type", "tasks"]
          }
        }
      }
    };

    try {
      const data = await fetchWithRetry(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
      if (text) {
        const suggestions = JSON.parse(text);
        const newItems = suggestions.map(s => ({
          id: Date.now().toString() + Math.random().toString(36).substring(7),
          description: s.description,
          type: s.type === 'multi' && s.tasks.length > 0 ? 'multi' : 'simple',
          checked: false,
          imageUrl: '',
          tasks: s.type === 'multi' ? s.tasks.filter(t => ['L', 'I', 'R'].includes(t)) : [],
          completedTasks: []
        }));

        const updated = {
          ...activeMachine,
          locations: activeMachine.locations.map(l => {
            if (l.id === activeLocation.id) {
              return { ...l, items: [...(l.items || []), ...newItems] };
            }
            return l;
          })
        };

        setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
        syncMachine(updated);
      }
    } catch (err) {
      console.error("Erro AI:", err);
      setDbError("Falha ao se comunicar com a IA. Tente novamente mais tarde.");
    } finally {
      setIsGeneratingAI(false);
    }
  };

  // --- LÓGICA DE DADOS: MÁQUINAS ---
  const handleAddMachine = async () => {
    const newMachine = {
      id: Date.now().toString(),
      name: 'Nova Máquina',
      line: activeTab || 'Linha 1',
      locations: []
    };
    const updatedMachines = [...machines, newMachine];
    setMachines(updatedMachines);
    await syncMachine(newMachine);
    setActiveMachineId(newMachine.id);
    setView('admin-machine-edit');
  };

  const handleUpdateMachine = (id, field, value) => {
    const machine = machines.find(m => m.id === id);
    if (!machine) return;
    const updated = { ...machine, [field]: value };
    setMachines(machines.map(m => m.id === id ? updated : m));
    syncMachine(updated);
  };

  const handleDeleteMachine = (id) => {
    setConfirmDialog({
      show: true,
      message: 'Excluir esta máquina e todos os seus locais?',
      onConfirm: async () => {
        setMachines(machines.filter(m => m.id !== id));
        setConfirmDialog({ show: false, message: '', onConfirm: null });
        if (user) {
          try {
            await deleteDoc(doc(db, 'artifacts', APP_ID_PATH, 'public', 'data', 'machines', id));
          } catch(e) {}
        }
      }
    });
  };

  // --- LÓGICA DE DADOS: LOCAIS ---
  const handleAddLocation = () => {
    if (!activeMachine) return;
    const newLocation = {
      id: Date.now().toString(),
      name: 'Novo Local (Ex: Cabeçote)',
      imageUrl: '',
      items: []
    };
    const updated = {
      ...activeMachine,
      locations: [...(activeMachine.locations || []), newLocation]
    };
    setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
    syncMachine(updated);
    setActiveLocationId(newLocation.id);
    setView('admin-location-edit');
  };

  const handleUpdateLocation = (locationId, field, value) => {
    if (!activeMachine) return;
    const updated = {
      ...activeMachine,
      locations: activeMachine.locations.map(l => l.id === locationId ? { ...l, [field]: value } : l)
    };
    setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
    syncMachine(updated);
  };

  const handleDeleteLocation = (locationId) => {
    if (!activeMachine) return;
    setConfirmDialog({
      show: true,
      message: 'Excluir este local e seus procedimentos?',
      onConfirm: () => {
        const updated = {
          ...activeMachine,
          locations: activeMachine.locations.filter(l => l.id !== locationId)
        };
        setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
        syncMachine(updated);
        setConfirmDialog({ show: false, message: '', onConfirm: null });
      }
    });
  };

  const handleImageUpload = (e, locationId) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const MAX_WIDTH = 500;
          let width = img.width;
          let height = img.height;
          if (width > MAX_WIDTH) {
            height = Math.round((height * MAX_WIDTH) / width);
            width = MAX_WIDTH;
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.4);
          handleUpdateLocation(locationId, 'imageUrl', compressedDataUrl);
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }
  };

  const handleItemImageUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const MAX_WIDTH = 500;
          let width = img.width;
          let height = img.height;
          if (width > MAX_WIDTH) {
            height = Math.round((height * MAX_WIDTH) / width);
            width = MAX_WIDTH;
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.4);
          setItemForm(prev => ({ ...prev, imageUrl: compressedDataUrl }));
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }
  };

  // --- LÓGICA DE DADOS: ITENS (PROCEDIMENTOS) ---
  const handleSaveNewItem = () => {
    if (!itemForm.description || !activeMachine || !activeLocation) return;
    
    const selectedTasks = Object.keys(itemForm.tasks).filter(k => itemForm.tasks[k]);
    const finalType = itemForm.type === 'multi' && selectedTasks.length > 0 ? 'multi' : 'simple';

    const newItem = { 
      id: Date.now().toString(), 
      description: itemForm.description,
      type: finalType,
      checked: false,
      imageUrl: itemForm.imageUrl,
      tasks: finalType === 'multi' ? selectedTasks : [],
      completedTasks: []
    };

    const updated = {
      ...activeMachine,
      locations: activeMachine.locations.map(l => {
        if (l.id === activeLocation.id) {
          return { ...l, items: [...(l.items || []), newItem] };
        }
        return l;
      })
    };
    
    setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
    syncMachine(updated);
    setItemModal({ show: false });
    setItemForm({ description: '', type: 'simple', tasks: { L: false, I: false, R: false }, imageUrl: '' });
  };

  const handleDeleteItem = (itemId) => {
    if (!activeMachine || !activeLocation) return;
    const updated = {
      ...activeMachine,
      locations: activeMachine.locations.map(l => {
        if (l.id === activeLocation.id) {
          return { ...l, items: l.items.filter(i => i.id !== itemId) };
        }
        return l;
      })
    };
    setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
    syncMachine(updated);
  };

  // --- LÓGICA DO OPERADOR (CHECKLIST) ---
  const handleToggleItem = (itemId, taskKey = null) => {
    if (!activeMachine || !activeLocation) return;
    
    const updated = {
      ...activeMachine,
      locations: activeMachine.locations.map(loc => {
        if (loc.id === activeLocation.id) {
          return {
            ...loc,
            items: loc.items.map(item => {
              if (item.id === itemId) {
                if (item.type === 'simple') {
                  return { ...item, checked: !item.checked };
                } else if (item.type === 'multi' && taskKey) {
                  const completed = item.completedTasks || [];
                  const isCompleted = completed.includes(taskKey);
                  return {
                    ...item,
                    completedTasks: isCompleted 
                      ? completed.filter(t => t !== taskKey)
                      : [...completed, taskKey]
                  };
                }
              }
              return item;
            })
          };
        }
        return loc;
      })
    };
    setMachines(machines.map(m => m.id === activeMachine.id ? updated : m));
    syncMachine(updated);
  };

  const isItemDone = (item) => {
    if (item.type === 'simple') return item.checked;
    return item.tasks && item.tasks.length > 0 && item.completedTasks && item.tasks.length === item.completedTasks.length;
  };

  const getLocationProgress = (loc) => {
    const items = loc.items || [];
    if (items.length === 0) return { completed: 0, total: 0, percentage: 0 };
    const completed = items.filter(isItemDone).length;
    return { completed, total: items.length, percentage: (completed / items.length) * 100 };
  };

  const getMachineProgress = (machine) => {
    let completed = 0;
    let total = 0;
    (machine.locations || []).forEach(loc => {
      const items = loc.items || [];
      total += items.length;
      completed += items.filter(isItemDone).length;
    });
    return { completed, total, percentage: total === 0 ? 0 : (completed / total) * 100 };
  };

  const handleFinishChecklist = () => {
    setConfirmDialog({
      show: true,
      message: 'Deseja finalizar esta limpeza e salvar no histórico da nuvem?',
      onConfirm: async () => {
        setConfirmDialog({ show: false, message: '', onConfirm: null }); 
        
        const currentMachine = machines.find(m => m.id === activeMachineId);
        if (!currentMachine) return;

        const completedArr = [];
        const pendingArr = [];

        (currentMachine.locations || []).forEach(loc => {
          (loc.items || []).forEach(item => {
            const desc = `${loc.name}: ${item.description}`;
            if (isItemDone(item)) {
              completedArr.push(desc);
            } else {
              pendingArr.push(desc);
            }
          });
        });

        const logId = Date.now().toString();
        const endTime = new Date().toISOString();
        
        const logEntry = {
          id: logId,
          machineId: currentMachine.id,
          machineName: currentMachine.name,
          line: currentMachine.line,
          startTime: sessionStartTime || endTime,
          endTime: endTime,
          completedPoints: completedArr,
          pendingPoints: pendingArr,
          totalPoints: completedArr.length + pendingArr.length,
        };

        if (user) {
          setSyncStatus('saving');
          try {
            const docRef = doc(db, 'artifacts', APP_ID_PATH, 'public', 'data', 'logs', logId);
            await setDoc(docRef, logEntry);
            setDbError('');
            setSyncStatus('synced');
          } catch(e) { 
            console.error("Erro ao salvar log:", e); 
            setDbError('Bloqueio no Banco: O Firestore não permitiu salvar o histórico.');
            setSyncStatus('error');
          }
        }

        const resetMachine = {
          ...currentMachine,
          locations: (currentMachine.locations || []).map(loc => ({
            ...loc,
            items: (loc.items || []).map(i => ({ ...i, checked: false, completedTasks: [] }))
          }))
        };
        
        setMachines(machines.map(m => m.id === currentMachine.id ? resetMachine : m));
        await syncMachine(resetMachine); 

        setView('operator-list');
      }
    });
  };

  const handleResetChecklist = () => {
    setConfirmDialog({
      show: true,
      message: 'Deseja desfazer todas as marcações desta máquina?',
      onConfirm: () => {
        if (activeMachine) {
           const resetMachine = {
             ...activeMachine,
             locations: (activeMachine.locations || []).map(loc => ({
               ...loc,
               items: (loc.items || []).map(i => ({ ...i, checked: false, completedTasks: [] }))
             }))
           };
           setMachines(machines.map(m => m.id === activeMachine.id ? resetMachine : m));
           syncMachine(resetMachine);
        }
        setConfirmDialog({ show: false, message: '', onConfirm: null });
      }
    });
  };

  const handleLoginSubmit = (e) => {
    e.preventDefault();
    if (passwordInput === 'Montagem123') {
      setIsAdminLoggedIn(true);
      setView('admin-list');
      setPasswordInput('');
    } else {
      alert('Senha Incorreta!');
      setPasswordInput('');
    }
  };

  const formatDate = (isoString) => {
    if (!isoString) return '--';
    const d = new Date(isoString);
    return d.toLocaleDateString('pt-BR') + ' às ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  };

  // --- RENDERIZAÇÃO DE INTERFACES ---

  const renderHome = () => (
    <div className="flex flex-col items-center justify-center min-h-[80vh] p-6 space-y-8">
      <div className="text-center space-y-2">
        <div className="w-20 h-20 bg-blue-600 rounded-2xl flex items-center justify-center mx-auto shadow-lg mb-4">
          <CheckCircle2 className="text-white w-12 h-12" />
        </div>
        <h1 className="text-3xl font-extrabold text-slate-800">CIL-R Digital</h1>
        <p className="text-slate-500">Limpeza, Inspeção e Lubrificação</p>
      </div>
      <div className="w-full max-w-sm space-y-4">
        <button onClick={goOperatorList} className="w-full flex items-center justify-center space-x-3 bg-blue-600 hover:bg-blue-700 text-white p-5 rounded-xl text-lg font-semibold shadow-md active:scale-95 transition-transform">
          <User className="w-6 h-6" /><span>Sou Operador</span>
        </button>
        <button onClick={goAdminList} className="w-full flex items-center justify-center space-x-3 bg-slate-100 hover:bg-slate-200 text-slate-700 p-5 rounded-xl text-lg font-semibold shadow-sm border border-slate-200 active:scale-95 transition-transform">
          <Settings className="w-6 h-6" /><span>Painel do Programador</span>
        </button>
      </div>
    </div>
  );

  const renderAdminLogin = () => (
    <div className="flex flex-col items-center justify-center min-h-[80vh] p-6">
      <div className="w-full max-w-sm bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
        <div className="flex justify-center mb-6">
          <div className="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-500">
            <Lock className="w-8 h-8" />
          </div>
        </div>
        <h2 className="text-2xl font-bold text-center text-slate-800 mb-2">Acesso Restrito</h2>
        <p className="text-center text-slate-500 text-sm mb-6">Senha do programador.</p>
        <form onSubmit={handleLoginSubmit} className="space-y-4">
          <input type="password" value={passwordInput} onChange={(e) => setPasswordInput(e.target.value)} placeholder="Senha..." className="w-full p-4 rounded-xl border border-slate-300 focus:border-blue-500 outline-none text-center text-lg tracking-widest" />
          <div className="flex space-x-3 pt-2">
            <button type="button" onClick={goHome} className="flex-1 py-3 bg-slate-100 text-slate-700 font-semibold rounded-xl">Voltar</button>
            <button type="submit" className="flex-1 py-3 bg-blue-600 text-white font-semibold rounded-xl shadow-md">Entrar</button>
          </div>
        </form>
      </div>
    </div>
  );

  const renderAdminList = () => {
    const filteredMachines = machines.filter(m => m.line === activeTab);
    return (
      <div className="p-4 max-w-lg mx-auto pb-24 h-screen flex flex-col">
